        "tier": "backend",
        "runtime": "Go 1.21",
        "port": 8084
      }
    },
    {
      "name": "user-credentials-db",
      "tier": "vault",
      "crown_jewel": true,
      "storage_engine": "MongoDB 6.0 (Encrypted)",
      "criticality": "CRITICAL",
      "label": "Database",
      "properties": {
        "name": "user-credentials-db",
        "tier": "vault",
        "crown_jewel": true,
        "storage_engine": "MongoDB 6.0 (Encrypted)",
        "criticality": "CRITICAL"
