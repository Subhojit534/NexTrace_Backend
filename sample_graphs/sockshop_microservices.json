      "port": 8082,
      "label": "Service",
      "properties": {
        "name": "orders-service",
        "tier": "backend",
        "runtime": "Java 17 / Spring Boot",
        "port": 8082
      }
    },
    {
      "name": "orders-db",
      "tier": "database",
      "storage_engine": "MongoDB 6.0",
      "port": 27017,
      "crown_jewel": true,
      "label": "Database",
      "properties": {
        "name": "orders-db",
        "tier": "database",
        "storage_engine": "MongoDB 6.0",
        "port": 27017,
        "crown_jewel": true
      }
    },
    {
      "name": "carts-service",
      "tier": "backend",
      "runtime": "Java 17 / Spring Boot",
      "port": 8083,
      "label": "Service",
      "properties": {
        "name": "carts-service",
        "tier": "backend",
        "runtime": "Java 17 / Spring Boot",
        "port": 8083
      }
    },
    {
      "name": "carts-db",
      "tier": "database",
      "storage_engine": "MongoDB 6.0",
      "port": 27017,
      "crown_jewel": true,
      "label": "Database",
      "properties": {
        "name": "carts-db",
        "tier": "database",
        "storage_engine": "MongoDB 6.0",
        "port": 27017,
        "crown_jewel": true
      }
    },
    {
      "name": "payment-service",
      "tier": "backend",
      "runtime": "Go 1.21",
      "port": 8080,
      "label": "Service",
      "properties": {
        "name": "payment-service",
        "tier": "backend",
        "runtime": "Go 1.21",
        "port": 8080
      }
    },
    {
      "name": "user-service",
      "tier": "backend",
      "runtime": "Go 1.21",
      "port": 8084,
      "label": "Service",
      "properties": {
