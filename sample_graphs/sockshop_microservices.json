{
  "id": "sock_shop",
  "name": "Weaveworks Sock Shop Cloud-Native",
  "description": "Standard cloud-native microservices benchmark with Traefik edge router, Spring Boot order services, and MongoDB vaults.",
  "nodes": [
    {
      "name": "edge-router",
      "tier": "edge",
      "public_facing": true,
      "runtime": "Traefik Ingress Controller",
      "port": 80,
      "label": "Gateway",
      "properties": {
        "name": "edge-router",
        "tier": "edge",
        "public_facing": true,
        "runtime": "Traefik Ingress Controller",
        "port": 80
      }
    },
    {
      "name": "front-end",
      "tier": "web",
      "runtime": "Node.js 18",
      "port": 8079,
      "label": "Service",
      "properties": {
        "name": "front-end",
        "tier": "web",
        "runtime": "Node.js 18",
        "port": 8079
      }
    },
    {
      "name": "catalogue-service",
      "tier": "backend",
      "runtime": "Go 1.21",
      "port": 8081,
      "label": "Service",
      "properties": {
        "name": "catalogue-service",
        "tier": "backend",
        "runtime": "Go 1.21",
        "port": 8081
      }
    },
    {
      "name": "catalogue-db",
      "tier": "database",
      "storage_engine": "MySQL 5.7",
      "port": 3306,
      "crown_jewel": true,
      "label": "Database",
      "properties": {
        "name": "catalogue-db",
        "tier": "database",
        "storage_engine": "MySQL 5.7",
        "port": 3306,
        "crown_jewel": true
      }
    },
    {
      "name": "orders-service",
      "tier": "backend",
