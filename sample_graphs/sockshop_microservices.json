    {
      "name": "pci-payment-vault",
      "tier": "vault",
      "crown_jewel": true,
      "storage_engine": "PostgreSQL 15 (PCI DSS)",
      "criticality": "CRITICAL",
      "label": "Database",
      "properties": {
        "name": "pci-payment-vault",
        "tier": "vault",
        "crown_jewel": true,
        "storage_engine": "PostgreSQL 15 (PCI DSS)",
        "criticality": "CRITICAL"
      }
    }
  ],
  "relationships": [
    {
      "from": "edge-router",
      "rel": "CALLS",
      "to": "front-end",
      "props": {
        "protocol": "HTTP/1.1"
      }
    },
    {
      "from": "front-end",
      "rel": "CALLS",
      "to": "catalogue-service",
      "props": {
        "protocol": "REST"
      }
    },
    {
      "from": "catalogue-service",
      "rel": "ACCESSES",
      "to": "catalogue-db",
      "props": {
        "port": 3306
      }
    },
    {
      "from": "front-end",
      "rel": "CALLS",
      "to": "carts-service",
      "props": {
        "protocol": "REST"
      }
    },
    {
      "from": "carts-service",
      "rel": "ACCESSES",
      "to": "carts-db",
      "props": {
        "port": 27017
      }
    },
    {
      "from": "front-end",
      "rel": "CALLS",
      "to": "orders-service",
      "props": {
        "protocol": "REST"
      }
    },
    {
      "from": "orders-service",
      "rel": "ACCESSES",
      "to": "orders-db",
      "props": {
        "port": 27017
      }
    },
    {
      "from": "orders-service",
      "rel": "CALLS",
      "to": "payment-service",
      "props": {
        "protocol": "REST"
      }
    },
    {
      "from": "orders-service",
      "rel": "CALLS",
      "to": "user-service",
      "props": {
        "protocol": "REST"
      }
    },
    {
      "from": "payment-service",
      "rel": "ACCESSES",
      "to": "pci-payment-vault",
      "props": {
        "permission": "pci_write"
      }
    },
    {
      "from": "user-service",
      "rel": "ACCESSES",
      "to": "user-credentials-db",
      "props": {
        "permission": "admin"
      }
    }
  ],
  "scenarios": {
    "Scenario A (Spring4Shell RCE in orders-service - CVE-2022-22965)": {
      "text": "CRITICAL: Spring4Shell Remote Code Execution in orders-service (CVE-2022-22965) targeting payment-vault and user credentials.",
      "service": "orders-service",
      "cve": "CVE-2022-22965"
    },
    "Scenario B (Payment Service RCE - CVE-2023-32731)": {
      "text": "HIGH SEVERITY: Remote execution attempt in payment-service targeting pci-payment-vault credit card records.",
      "service": "payment-service",
      "cve": "CVE-2023-32731"
    },
    "Scenario C (Front-End Rapid Reset DoS - CVE-2023-44487)": {
      "text": "HIGH SEVERITY: HTTP/2 DoS flood targeting edge front-end container.",
      "service": "front-end",
      "cve": "CVE-2023-44487"
    }
  }
}